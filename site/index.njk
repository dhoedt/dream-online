---
title: Cours d'informatique - DYL
---
{% extends "layouts/base.njk" %}
{% block main %}
  <h1>{{ title }}</h1>

  <div class="tabs" role="tablist" aria-label="Sections du site">
    <button type="button" role="tab" id="tab-exercises" aria-controls="exercises">Exercices</button>
    <button type="button" role="tab" id="tab-lessons" aria-controls="lessons">Leçons</button>
    <button type="button" role="tab" id="tab-resources" aria-controls="resources">Ressources</button>
  </div>

  <section class="tab-panel" role="tabpanel" id="resources" aria-labelledby="tab-resources">
    <ul class="exercise-list">
{%- for resource in resources %}
      <li>
        <a class="exercise-link" href="{{ resource.url }}" target="_blank" rel="noopener">
          <span class="exercise-title">{{ resource.title }}</span>
          <span class="link-host">{{ resource.host }}</span>
        </a>
      </li>
{%- endfor %}
    </ul>
  </section>

  <section class="tab-panel" role="tabpanel" id="lessons" aria-labelledby="tab-lessons">
{%- set pages = collections.lessons %}
{% include "partials/page-list.njk" %}
  </section>

  <section class="tab-panel" role="tabpanel" id="exercises" aria-labelledby="tab-exercises">
{%- set pages = collections.exercises %}
{% include "partials/page-list.njk" %}
  </section>
{% endblock %}

{% block after_main %}
<footer class="site-footer">
  <p>build: <time datetime="{{ build.datetime }}">{{ build.label }}</time> · {{ build.commit }}</p>
</footer>

<script>
  const tabs = [...document.querySelectorAll('[role="tab"]')];

  // The active tab is kept in the URL (#lessons, #exercises…) so it survives the back button.
  function selectTab(panelId) {
    for (const tab of tabs) {
      const isSelected = tab.getAttribute('aria-controls') === panelId;
      tab.setAttribute('aria-selected', String(isSelected));
      tab.tabIndex = isSelected ? 0 : -1;
      document.getElementById(tab.getAttribute('aria-controls')).hidden = !isSelected;
    }
    history.replaceState(null, '', `#${panelId}`);
  }

  function panelIdFromHash() {
    const hashId = location.hash.slice(1);
    const hasTab = tabs.some((tab) => tab.getAttribute('aria-controls') === hashId);
    return hasTab ? hashId : tabs[0].getAttribute('aria-controls');
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => selectTab(tab.getAttribute('aria-controls')));
    tab.addEventListener('keydown', (event) => {
      const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
      if (!step) {
        return;
      }
      const nextTab = tabs[(tabs.indexOf(tab) + step + tabs.length) % tabs.length];
      selectTab(nextTab.getAttribute('aria-controls'));
      nextTab.focus();
    });
  }

  selectTab(panelIdFromHash());
</script>
{% endblock %}
